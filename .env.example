# required env variables for E2E testing (tests/e2e) - tests are skipped if missing
E2E_BASE_URL={your DRACOON domain}
E2E_USER_NAME={your local e2e user username}
E2E_PASSWORD={your local e2e user password}
# room for test data (e2e user: room admin) - use a short recycle bin retention period
E2E_ROOM_ID={room id}

# optional
CLIENT_ID={OAuth client id - default: dracoon_legacy_scripting}
CLIENT_SECRET={OAuth client secret}
E2E_EMAIL_DOMAIN={email domain for created test users - default: example.com}
# encrypted transfers - skipped if missing (the e2e user's existing keypair is used, never changed)
E2E_CRYPTO_ROOM_ID={encrypted room id}
E2E_CRYPTO_SECRET={keypair secret of the e2e user}
